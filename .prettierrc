{
    "$schema": "https://json.schemastore.org/prettierrc",
    "arrowParens": "always",
    "semi": true,
    "trailingComma": "all",
    "tabWidth": 4,
    "endOfLine": "auto",
    "useTabs": false,
    "singleQuote": false,
    "printWidth": 100,
    "jsxSingleQuote": false,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "quoteProps": "as-needed",
    "proseWrap": "preserve",
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
